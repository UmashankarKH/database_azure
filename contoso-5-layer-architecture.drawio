<mxfile host="app.diagrams.net"><diagram id="arch" name="5-layer architecture"><mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Contoso Delay-Risk Copilot: 5-Layer Azure Architecture (Databases + ML + LLM)" style="text;html=1;align=center;fontSize=20;fontStyle=1;fontColor=#1f3864;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Facts come from databases, numbers come from ML, words come from the LLM. The LLM never guesses." style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1240" height="22" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#2e75b6;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1240" height="130" as="geometry"/></mxCell><mxCell id="c5" value="1. Experience&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Who uses it&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#2e75b6;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="170" height="122" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8ec;strokeColor=#548235;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1240" height="150" as="geometry"/></mxCell><mxCell id="c7" value="2. Application&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Orchestration and safety&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#548235;" vertex="1" parent="1"><mxGeometry x="30" y="234" width="170" height="142" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#c55a11;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="1240" height="170" as="geometry"/></mxCell><mxCell id="c9" value="3. AI and ML&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Predict and explain&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#c55a11;" vertex="1" parent="1"><mxGeometry x="30" y="404" width="170" height="162" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6eefb;strokeColor=#7030a0;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="1240" height="180" as="geometry"/></mxCell><mxCell id="c11" value="4. Data&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Source of truth&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#7030a0;" vertex="1" parent="1"><mxGeometry x="30" y="594" width="170" height="172" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#595959;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="1240" height="110" as="geometry"/></mxCell><mxCell id="c13" value="5. Platform&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Security, cost, ops&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=1;fontSize=13;fontColor=#595959;" vertex="1" parent="1"><mxGeometry x="30" y="794" width="170" height="102" as="geometry"/></mxCell><mxCell id="c14" value="Customer&lt;br&gt;Web chat or app&lt;br&gt;&quot;Will my order be late?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e75b6;fontColor=#1a1a1a;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="105" width="200" height="80" as="geometry"/></mxCell><mxCell id="c15" value="Support agent&lt;br&gt;Review queue screen&lt;br&gt;(approve or edit messages)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e75b6;fontColor=#1a1a1a;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="105" width="200" height="80" as="geometry"/></mxCell><mxCell id="c16" value="Order system event&lt;br&gt;New order or status change&lt;br&gt;(push trigger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e75b6;fontColor=#1a1a1a;fontSize=12;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="105" width="200" height="80" as="geometry"/></mxCell><mxCell id="c17" value="Azure Static Web Apps&lt;br&gt;Front end (last class)&lt;br&gt;Entra ID sign in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2e75b6;fontColor=#1a1a1a;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="105" width="260" height="80" as="geometry"/></mxCell><mxCell id="c18" value="Azure Functions or App Service&lt;br&gt;API and Copilot service&lt;br&gt;Gets customer_id from the login session, never from the LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548235;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="255" width="220" height="100" as="geometry"/></mxCell><mxCell id="c19" value="Orchestrator&lt;br&gt;Tool calling loop&lt;br&gt;get_order_status&lt;br&gt;search_policy&lt;br&gt;predict_delay_risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548235;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="255" width="220" height="100" as="geometry"/></mxCell><mxCell id="c20" value="Guardrails&lt;br&gt;Grounded answers only&lt;br&gt;Reason codes from rules&lt;br&gt;Low confidence goes to human" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548235;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="255" width="200" height="100" as="geometry"/></mxCell><mxCell id="c21" value="Change feed trigger&lt;br&gt;Azure Function&lt;br&gt;Reacts to new or changed orders (push)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548235;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="255" width="220" height="100" as="geometry"/></mxCell><mxCell id="c22" value="Microsoft Foundry&lt;br&gt;Azure OpenAI deployment: chat&lt;br&gt;Decides which tool to call&lt;br&gt;Writes the final message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#c55a11;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="430" width="230" height="110" as="geometry"/></mxCell><mxCell id="c23" value="Foundry deployment: embed&lt;br&gt;Turns policy text and&lt;br&gt;questions into vectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#c55a11;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="200" height="110" as="geometry"/></mxCell><mxCell id="c24" value="Azure ML managed online endpoint&lt;br&gt;AutoML model trained on 10,000 orders&lt;br&gt;Returns P(delayed) in under 1 second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#c55a11;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="750" y="430" width="230" height="110" as="geometry"/></mxCell><mxCell id="c25" value="Azure ML training&lt;br&gt;Data asset + AutoML job&lt;br&gt;Compute cluster scales to 0&lt;br&gt;Model registry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="430" width="200" height="110" as="geometry"/></mxCell><mxCell id="c26" value="Azure SQL Database&lt;br&gt;Orders, customers, features&lt;br&gt;Only via llm schema views&lt;br&gt;(least privilege)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7030a0;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="620" width="220" height="120" as="geometry"/></mxCell><mxCell id="c27" value="Cosmos DB for NoSQL&lt;br&gt;Order events, review queue&lt;br&gt;Partition key, TTL&lt;br&gt;Change feed = push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7030a0;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="500" y="620" width="220" height="120" as="geometry"/></mxCell><mxCell id="c28" value="PostgreSQL Flexible Server&lt;br&gt;pgvector with HNSW index&lt;br&gt;Policy and FAQ chunks&lt;br&gt;For meaning search (RAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7030a0;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="220" height="120" as="geometry"/></mxCell><mxCell id="c29" value="Azure Managed Redis&lt;br&gt;Cache of repeated answers&lt;br&gt;Rate limits per customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7030a0;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="620" width="200" height="120" as="geometry"/></mxCell><mxCell id="c30" value="Microsoft Entra ID&lt;br&gt;Sign in, roles, managed identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#595959;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="240" y="815" width="200" height="65" as="geometry"/></mxCell><mxCell id="c31" value="Key Vault&lt;br&gt;Endpoint key, secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#595959;fontColor=#1a1a1a;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="470" y="815" width="200" height="65" as="geometry"/></mxCell><mxCell id="c32" value="Azure Monitor + App Insights&lt;br&gt;Logs, latency, token use" style="round